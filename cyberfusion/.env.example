# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Initial admin password (12+ chars, mixed case, a digit). If empty, one is generated and printed in the backend log on first run.
ADMIN_PASSWORD=
# true = load clearly-labelled demo data and demo users (shared demo password). Keep false in production.
DEMO_DATA=true
DEMO_PASSWORD=CyberFusion-Demo-2026
